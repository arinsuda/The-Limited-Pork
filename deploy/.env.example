# Copy to deploy/.env and change secrets.  `cp deploy/.env.example deploy/.env`
COMPOSE_PROJECT_NAME=moo-krob
TZ=Asia/Bangkok

POSTGRES_IMAGE_TAG=17-alpine
POSTGRES_DB=mookrob
POSTGRES_USER=mookrob
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5433

REDIS_IMAGE_TAG=7-alpine
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

MINIO_IMAGE=cgr.dev/chainguard/minio:latest
MINIO_MC_IMAGE=cgr.dev/chainguard/minio-client:latest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-root
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=mookrob
MINIO_APP_ACCESS_KEY=mookrob-app
MINIO_APP_SECRET_KEY=change-me-minio-app-secret

MAILPIT_IMAGE_TAG=latest
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Only used with `--profile app`
API_PORT=8080
WEB_PORT=8081
WEB_API_BASE_URL=/api/v1
WEB_WS_URL=
