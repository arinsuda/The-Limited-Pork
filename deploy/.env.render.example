# ==============================================================================
# Render Backend Environment Variables (Production)
# ==============================================================================
# Copy and set these in Render Dashboard -> Environment -> Environment Variables

APP_ENV=production
LOG_LEVEL=info
AUTO_MIGRATE=true

# Database (PostgreSQL)
# Either provide DATABASE_URL from Render Postgres, Neon, or Supabase:
# DATABASE_URL=postgres://user:password@hostname:5432/mookrob?sslmode=require
# Or if using individual variables:
# DB_HOST=hostname
# DB_PORT=5432
# DB_NAME=mookrob
# DB_USER=mookrob
# DB_PASSWORD=your-secure-password
# DB_SSLMODE=require

# In-Memory Cache (Free Tier Zero Cost — no external Redis required)
REDIS_ADDR=memory
# (Optional) If you have an Upstash Redis URL:
# REDIS_URL=rediss://default:password@endpoint.upstash.io:6379

# Cloudflare R2 Object Storage (S3-Compatible)
# 1. Endpoint: Found in Cloudflare Dashboard -> R2 -> Overview -> "S3 API" (e.g. <ACCOUNT_ID>.r2.cloudflarestorage.com)
MINIO_ENDPOINT=YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
MINIO_USE_SSL=true
# 2. Access Keys: Created in R2 -> "Manage R2 API Tokens"
MINIO_ACCESS_KEY=YOUR_R2_ACCESS_KEY_ID
MINIO_SECRET_KEY=YOUR_R2_SECRET_ACCESS_KEY
# 3. Bucket Name
MINIO_BUCKET=mookrob
# 4. (Optional) Public Bucket URL: If public bucket access is enabled (e.g. https://pub-xxxxxx.r2.dev)
# MINIO_PUBLIC_ENDPOINT=https://pub-xxxxxx.r2.dev

# JWT Security (Generate a random 32+ character string)
JWT_SECRET=super-secret-crispy-pork-jwt-signing-key-minimum-32-bytes
JWT_ISSUER=mookrob-api
JWT_AUDIENCE=mookrob-web

# Cookies & Cross-Site Security (Required for Cloudflare Pages <-> Render communication)
COOKIE_SAME_SITE=None
COOKIE_SECURE=true

# CORS: Set your Cloudflare Pages URL here (or wildcards)
CORS_ALLOWED_ORIGINS=https://*.pages.dev,http://localhost:5173,https://localhost,http://localhost,capacitor://localhost

# Admin Initial Account (will be auto-created on first boot)
BOOTSTRAP_ADMIN_EMAIL=admin@mookrob.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@123456
BOOTSTRAP_ADMIN_NAME=Owner Admin
