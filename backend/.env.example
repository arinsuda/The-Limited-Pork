HTTP_PORT=8080
LOG_LEVEL=info
APP_TIMEZONE=Asia/Bangkok
SHUTDOWN_TIMEOUT_SECONDS=15s

# Database
DB_HOST=localhost
DB_PORT=5433
DB_NAME=mookrob
DB_USER=mookrob
DB_PASSWORD=change-me-postgres
DB_SSLMODE=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=change-me-redis
REDIS_DB=0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=mookrob-app
MINIO_SECRET_KEY=change-me-minio-app-secret
MINIO_BUCKET=mookrob
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_PRESIGN_TTL_MINUTES=60

# Auth & JWT
JWT_SECRET=super-secret-crispy-pork-jwt-signing-key-minimum-32-bytes
JWT_ISSUER=mookrob-api
JWT_AUDIENCE=mookrob-web
ACCESS_TOKEN_TTL_MINUTES=15m
REFRESH_TOKEN_TTL_DAYS=168h

COOKIE_NAME=mookrob_rt
COOKIE_PATH=/api/v1/auth
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict
COOKIE_DOMAIN=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8081

RATE_LIMIT_LOGIN_PER_MINUTE=10
PAGINATION_DEFAULT_PAGE_SIZE=20
PAGINATION_MAX_PAGE_SIZE=100

UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

WS_TICKET_TTL_SECONDS=60s
WS_PING_INTERVAL_SECONDS=25s
WS_WRITE_TIMEOUT_SECONDS=10s
WS_MAX_MESSAGE_BYTES=4096

OUTBOX_POLL_INTERVAL_MS=500ms
OUTBOX_BATCH_SIZE=50

PROCESS_TEMP_MIN_C=0
PROCESS_TEMP_MAX_C=350
TRIAL_COMPARE_MAX=5
RECIPE_CODE_PREFIX=RCP

BOOTSTRAP_ADMIN_EMAIL=admin@mookrob.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@123456
BOOTSTRAP_ADMIN_NAME=เจ้าของร้าน (Admin)
