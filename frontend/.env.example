# ------------------------------------------------------------------
# Frontend runtime configuration (all values are validated by Zod in
# src/shared/config/env.ts). Copy to `.env.local` and adjust.
# ------------------------------------------------------------------

# REST API base URL. Relative path keeps requests same-origin (dev proxy / nginx).
VITE_API_BASE_URL=/api/v1
# WebSocket endpoint. Leave empty to derive from VITE_API_BASE_URL (+ "/ws").
VITE_WS_URL=

# i18n
VITE_DEFAULT_LOCALE=th
VITE_SUPPORTED_LOCALES=th,en

# Date display calendar: "buddhist" (พ.ศ.) or "gregorian" (ค.ศ.). Users can override in the UI.
VITE_DATE_CALENDAR=buddhist

# Theme default: light | dark | system
VITE_DEFAULT_THEME=system

# TanStack Query
VITE_QUERY_STALE_TIME_MS=30000
VITE_QUERY_RETRY=1

# Paging / search
VITE_DEFAULT_PAGE_SIZE=20
VITE_SEARCH_DEBOUNCE_MS=300

# WebSocket reconnect (exponential backoff with jitter) and keep-alive
VITE_WS_BACKOFF_MIN_MS=1000
VITE_WS_BACKOFF_MAX_MS=30000
VITE_WS_PING_INTERVAL_MS=25000

# Toasts
VITE_TOAST_DURATION_MS=4000

# Uploads (client-side pre-check; server is authoritative)
VITE_UPLOAD_MAX_BYTES=10485760
VITE_UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Trials compare (should match backend TRIAL_COMPARE_MAX)
VITE_TRIAL_COMPARE_MAX=5

# Process temperature hints (should match backend PROCESS_TEMP_MIN_C/MAX_C)
VITE_PROCESS_TEMP_MIN_C=0
VITE_PROCESS_TEMP_MAX_C=300

# ---- Dev server only (read by vite.config.ts via loadEnv) ----
VITE_DEV_PROXY_TARGET=http://localhost:8080
VITE_DEV_PORT=5173
