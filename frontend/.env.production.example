# ==============================================================================
# Cloudflare Pages Environment Variables (Production)
# ==============================================================================
# Set these in Cloudflare Dashboard -> Workers & Pages -> your project -> Settings -> Environment Variables

# Backend API endpoint URL (replace with your Render backend URL)
VITE_API_BASE_URL=https://mookrob-api.onrender.com/api/v1

# WebSocket URL (optional, wss:// scheme)
VITE_WS_URL=wss://mookrob-api.onrender.com/ws

# Default Locale
VITE_DEFAULT_LOCALE=th
