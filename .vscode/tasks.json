{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "infra: up",
      "type": "shell",
      "command": "make infra-up",
      "problemMatcher": []
    },
    {
      "label": "backend: migrate",
      "type": "shell",
      "command": "make migrate",
      "problemMatcher": []
    },
    {
      "label": "backend: dev (air)",
      "type": "shell",
      "command": "make be-dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "frontend: dev",
      "type": "shell",
      "command": "make fe-dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": { "activesBegin": ".", "beginsPattern": "VITE", "endsPattern": "Local:" }
      }
    },
    {
      "label": "test: all",
      "type": "shell",
      "command": "make test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$go"]
    }
  ]
}
